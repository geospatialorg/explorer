# Server-side environment variables (NOT committed to git)
# Copy this to .env.production on the server and fill in real values.

DATABASE_URL=postgresql://user:password@host.docker.internal:25432/explorer
TITILER_URL=http://host.docker.internal:8000
ADMIN_CREDENTIALS=admin:change-me
ADMIN_SECRET=change-me-random-string
DEFAULT_LOCALE=ro
SUPPORTED_LOCALES=ro,en
